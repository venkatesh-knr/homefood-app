# Copy this file to .env.local and fill in the two values from
# Supabase › Project Settings › API (or "API Keys" in newer versions).
# Both are public by design; never put the service_role/secret key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
